# Copy this file to `.env` and paste your key in.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your key is an ORG-level key rather than a workspace key.
# Symptom: 400 "not scoped to a workspace".
# Find the ID at https://console.anthropic.com/settings/workspaces
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
